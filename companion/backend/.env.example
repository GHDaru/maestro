# Companion do livro Maestro — copie para .env (que é gitignored) e preencha.
# NENHUM valor real deste arquivo vai para o repositório.

# Modelo (NVIDIA NIM por padrão). Sem chave, o adaptador cai para "echo".
OPENAI_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct

# Persistência (Neon/Postgres). Sem isto, memória.
DATABASE_URL=

# Origens permitidas (CORS), separadas por vírgula.
CORS_ORIGENS=https://ghdaru.github.io,http://localhost:8000
