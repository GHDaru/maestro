<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Def_chamado" targetNamespace="https://hindiana.com.br/maestro/workflow-chamado" exporter="Maestro (Hindiana Assistente)" exporterVersion="1.0">
  <bpmn:signal id="Sig_entregue" name="Chamado entregue" />
  <bpmn:collaboration id="Colab_chamado">
    <bpmn:participant id="Pool_chamado" name="Chamado do cliente: da abertura à produção (Maestro)" processRef="Proc_chamado" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_chamado" name="Chamado do cliente" isExecutable="false">
    <bpmn:laneSet id="LaneSet_chamado">
      <bpmn:lane id="Lane_cliente" name="Cliente (quem abre o chamado)">
        <bpmn:flowNodeRef>S_chamado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_compl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_resp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_recusa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_resp2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_neg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_respduv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_uat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_receber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_dono" name="Dono do produto (Gilsiley)">
        <bpmn:flowNodeRef>T_decidir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ordem</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_office" name="Hindiana Office (triagem e plano)">
        <bpmn:flowNodeRef>T_triar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_avaliar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_aceita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_incid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_risco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_aloca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_comunica</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_spec" name="Especificação (spec, plan, tasks)">
        <bpmn:flowNodeRef>T_painel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_specify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_tasks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gerente" name="Gerente (despacho e integração)">
        <bpmn:flowNodeRef>T_despacho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_integ</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_autor" name="Worker autor">
        <bpmn:flowNodeRef>T_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_red</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_green</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_criticos" name="Críticos às cegas (2)">
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_crit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_crit2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ci" name="runner2 (não autor, clone limpo)">
        <bpmn:flowNodeRef>T_runner2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bancada" name="Bancada: VM 202, Dev 212, staging">
        <bpmn:flowNodeRef>T_vm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_dev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_staging</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_testes" name="Sessão de testes (tela, item a item)">
        <bpmn:flowNodeRef>T_repro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_sev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_tela</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_prod" name="Produção (Railway)">
        <bpmn:flowNodeRef>T_backup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_push</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_pos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_rollback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_assist" name="Assistente (auditoria do método)">
        <bpmn:flowNodeRef>S_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_desv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_aud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_entregue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_retro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_retro</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_chamado" name="Chamado aberto (bug, melhoria ou sugestão)">
      <bpmn:outgoing>F_00_S_chamado_T_triar</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_triar" name="Triar: tipo, severidade, evidência">
      <bpmn:incoming>F_00_S_chamado_T_triar</bpmn:incoming>
      <bpmn:incoming>F_07_T_compl_T_triar</bpmn:incoming>
      <bpmn:outgoing>F_01_T_triar_G_tipo</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_tipo" name="Tipo do chamado?">
      <bpmn:incoming>F_01_T_triar_G_tipo</bpmn:incoming>
      <bpmn:outgoing>F_02_G_tipo_T_repro</bpmn:outgoing>
      <bpmn:outgoing>F_03_G_tipo_T_avaliar</bpmn:outgoing>
      <bpmn:outgoing>F_04_G_tipo_J_merge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_repro" name="Reproduzir no staging com os passos do cliente">
      <bpmn:incoming>F_02_G_tipo_T_repro</bpmn:incoming>
      <bpmn:outgoing>F_05_T_repro_G0</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_avaliar" name="Avaliar valor e alinhamento ao roadmap">
      <bpmn:incoming>F_03_G_tipo_T_avaliar</bpmn:incoming>
      <bpmn:outgoing>F_12_T_avaliar_G_aceita</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G0" name="G0 Reproduzido?">
      <bpmn:incoming>F_05_T_repro_G0</bpmn:incoming>
      <bpmn:outgoing>F_06_G0_T_compl</bpmn:outgoing>
      <bpmn:outgoing>F_08_G0_G_sev</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_aceita" name="Sugestão aceita?">
      <bpmn:incoming>F_12_T_avaliar_G_aceita</bpmn:incoming>
      <bpmn:outgoing>F_13_G_aceita_T_resp</bpmn:outgoing>
      <bpmn:outgoing>F_15_G_aceita_J_merge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_compl" name="Complementar evidência (passos, captura, ambiente)">
      <bpmn:incoming>F_06_G0_T_compl</bpmn:incoming>
      <bpmn:outgoing>F_07_T_compl_T_triar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_sev" name="Crítico em produção?">
      <bpmn:incoming>F_08_G0_G_sev</bpmn:incoming>
      <bpmn:outgoing>F_09_G_sev_T_incid</bpmn:outgoing>
      <bpmn:outgoing>F_10_G_sev_J_merge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_resp" name="Receber resposta justificada">
      <bpmn:incoming>F_13_G_aceita_T_resp</bpmn:incoming>
      <bpmn:outgoing>F_14_T_resp_E_recusa</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_incid" name="Abrir incidente e SLA de correção">
      <bpmn:incoming>F_09_G_sev_T_incid</bpmn:incoming>
      <bpmn:outgoing>F_11_T_incid_J_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_recusa" name="Sugestão encerrada">
      <bpmn:incoming>F_14_T_resp_E_recusa</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="J_merge" name="">
      <bpmn:incoming>F_04_G_tipo_J_merge</bpmn:incoming>
      <bpmn:incoming>F_10_G_sev_J_merge</bpmn:incoming>
      <bpmn:incoming>F_11_T_incid_J_merge</bpmn:incoming>
      <bpmn:incoming>F_15_G_aceita_J_merge</bpmn:incoming>
      <bpmn:outgoing>F_16_J_merge_T_risco</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_risco" name="Classificar risco: reversibilidade × impacto">
      <bpmn:incoming>F_16_J_merge_T_risco</bpmn:incoming>
      <bpmn:outgoing>F_17_T_risco_GD</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GD" name="GD Decisão humana? (classe C)">
      <bpmn:incoming>F_17_T_risco_GD</bpmn:incoming>
      <bpmn:outgoing>F_18_GD_T_painel</bpmn:outgoing>
      <bpmn:outgoing>F_19_GD_J2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_painel" name="Painel de 3 especialistas, recomendação e ADR">
      <bpmn:incoming>F_18_GD_T_painel</bpmn:incoming>
      <bpmn:outgoing>F_20_T_painel_T_decidir</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_decidir" name="Decidir: aprovar, ajustar ou rejeitar">
      <bpmn:incoming>F_20_T_painel_T_decidir</bpmn:incoming>
      <bpmn:outgoing>F_21_T_decidir_G_dec</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_dec" name="Aprovado?">
      <bpmn:incoming>F_21_T_decidir_G_dec</bpmn:incoming>
      <bpmn:outgoing>F_22_G_dec_J2</bpmn:outgoing>
      <bpmn:outgoing>F_23_G_dec_T_resp2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_resp2" name="Receber a decisão e o ADR">
      <bpmn:incoming>F_23_G_dec_T_resp2</bpmn:incoming>
      <bpmn:outgoing>F_24_T_resp2_E_neg</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_neg" name="Encerrado sem entrega">
      <bpmn:incoming>F_24_T_resp2_E_neg</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="J2" name="">
      <bpmn:incoming>F_19_GD_J2</bpmn:incoming>
      <bpmn:incoming>F_22_G_dec_J2</bpmn:incoming>
      <bpmn:outgoing>F_25_J2_T_specify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_specify" name="Specify: spec.md com requisitos EARS">
      <bpmn:incoming>F_25_J2_T_specify</bpmn:incoming>
      <bpmn:incoming>F_32_G1_T_specify</bpmn:incoming>
      <bpmn:incoming>F_62_G7_T_specify</bpmn:incoming>
      <bpmn:outgoing>F_26_T_specify_T_clarify</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_clarify" name="Clarify: perguntas ao cliente">
      <bpmn:incoming>F_26_T_specify_T_clarify</bpmn:incoming>
      <bpmn:outgoing>F_27_T_clarify_T_respduv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_respduv" name="Responder dúvidas e validar critérios de aceite">
      <bpmn:incoming>F_27_T_clarify_T_respduv</bpmn:incoming>
      <bpmn:outgoing>F_28_T_respduv_T_plan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_plan" name="Plan: plan.md com Domain model (agregados, linguagem ubíqua)">
      <bpmn:incoming>F_28_T_respduv_T_plan</bpmn:incoming>
      <bpmn:outgoing>F_29_T_plan_T_tasks</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_tasks" name="Tasks: tasks.md com ids T#-##">
      <bpmn:incoming>F_29_T_plan_T_tasks</bpmn:incoming>
      <bpmn:outgoing>F_30_T_tasks_T_analyze</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_analyze" name="Analyze: spec ↔ plan ↔ tasks e check-conformance DOM">
      <bpmn:incoming>F_30_T_tasks_T_analyze</bpmn:incoming>
      <bpmn:outgoing>F_31_T_analyze_G1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="G1 Spec pronta? (2 críticas de spec)">
      <bpmn:incoming>F_31_T_analyze_G1</bpmn:incoming>
      <bpmn:outgoing>F_32_G1_T_specify</bpmn:outgoing>
      <bpmn:outgoing>F_33_G1_T_aloca</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_aloca" name="Alocar worker e base">
      <bpmn:incoming>F_33_G1_T_aloca</bpmn:incoming>
      <bpmn:outgoing>F_34_T_aloca_T_despacho</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_despacho" name="Despachar bloco: base, branch, worktree">
      <bpmn:incoming>F_34_T_aloca_T_despacho</bpmn:incoming>
      <bpmn:outgoing>F_35_T_despacho_T_conf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_conf" name="Confirmar o bloco ao Gerente">
      <bpmn:incoming>F_35_T_despacho_T_conf</bpmn:incoming>
      <bpmn:outgoing>F_36_T_conf_T_red</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_red" name="Commitar o teste vermelho">
      <bpmn:incoming>F_36_T_conf_T_red</bpmn:incoming>
      <bpmn:incoming>F_38_G2_T_red</bpmn:incoming>
      <bpmn:incoming>F_58_G6_T_red</bpmn:incoming>
      <bpmn:incoming>F_69_T_rollback_T_red</bpmn:incoming>
      <bpmn:outgoing>F_37_T_red_G2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="G2 Vermelho prova o defeito?">
      <bpmn:incoming>F_37_T_red_G2</bpmn:incoming>
      <bpmn:outgoing>F_38_G2_T_red</bpmn:outgoing>
      <bpmn:outgoing>F_39_G2_T_green</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_green" name="Implementar e commitar o verde (0 failed, 0 errors local)">
      <bpmn:incoming>F_39_G2_T_green</bpmn:incoming>
      <bpmn:incoming>F_48_G3_T_green</bpmn:incoming>
      <bpmn:incoming>F_52_G4_T_green</bpmn:incoming>
      <bpmn:incoming>F_55_G5_T_green</bpmn:incoming>
      <bpmn:outgoing>F_40_T_green_P_fork</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P_fork" name="">
      <bpmn:incoming>F_40_T_green_P_fork</bpmn:incoming>
      <bpmn:outgoing>F_41_P_fork_T_crit1</bpmn:outgoing>
      <bpmn:outgoing>F_42_P_fork_T_runner2</bpmn:outgoing>
      <bpmn:outgoing>F_43_P_fork_T_crit2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_runner2" name="runner2 no hash: 0 failed, 0 errors (×3)">
      <bpmn:incoming>F_42_P_fork_T_runner2</bpmn:incoming>
      <bpmn:outgoing>F_45_T_runner2_P_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_crit1" name="Crítica 1: código (segue a chamada, testa o boundary)">
      <bpmn:incoming>F_41_P_fork_T_crit1</bpmn:incoming>
      <bpmn:outgoing>F_44_T_crit1_P_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_crit2" name="Crítica 2: critério (reproduz a fonte: Excel, Template, tela)">
      <bpmn:incoming>F_43_P_fork_T_crit2</bpmn:incoming>
      <bpmn:outgoing>F_46_T_crit2_P_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="P_join" name="">
      <bpmn:incoming>F_44_T_crit1_P_join</bpmn:incoming>
      <bpmn:incoming>F_45_T_runner2_P_join</bpmn:incoming>
      <bpmn:incoming>F_46_T_crit2_P_join</bpmn:incoming>
      <bpmn:outgoing>F_47_P_join_G3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="G3" name="G3 2 APPROVE + runner2 + vereditos commitados?">
      <bpmn:incoming>F_47_P_join_G3</bpmn:incoming>
      <bpmn:outgoing>F_48_G3_T_green</bpmn:outgoing>
      <bpmn:outgoing>F_49_G3_T_integ</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_integ" name="Integrar a série na rc (cherry-pick, patch-id)">
      <bpmn:incoming>F_49_G3_T_integ</bpmn:incoming>
      <bpmn:outgoing>F_50_T_integ_T_vm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_vm" name="VM 202: suíte no Postgres, migração sobe/desce/sobe">
      <bpmn:incoming>F_50_T_integ_T_vm</bpmn:incoming>
      <bpmn:outgoing>F_51_T_vm_G4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="G4 VM verde?">
      <bpmn:incoming>F_51_T_vm_G4</bpmn:incoming>
      <bpmn:outgoing>F_52_G4_T_green</bpmn:outgoing>
      <bpmn:outgoing>F_53_G4_T_dev</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_dev" name="Dev 212: subir a rc e rodar a barra v2 T0–T5">
      <bpmn:incoming>F_53_G4_T_dev</bpmn:incoming>
      <bpmn:outgoing>F_54_T_dev_G5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G5" name="G5 Barra PASSA no hash exato?">
      <bpmn:incoming>F_54_T_dev_G5</bpmn:incoming>
      <bpmn:outgoing>F_55_G5_T_green</bpmn:outgoing>
      <bpmn:outgoing>F_56_G5_T_tela</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_tela" name="Teste por tela, item a item, contra o pedido do cliente">
      <bpmn:incoming>F_56_G5_T_tela</bpmn:incoming>
      <bpmn:outgoing>F_57_T_tela_G6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G6" name="G6 Todos os itens PASSA?">
      <bpmn:incoming>F_57_T_tela_G6</bpmn:incoming>
      <bpmn:outgoing>F_58_G6_T_red</bpmn:outgoing>
